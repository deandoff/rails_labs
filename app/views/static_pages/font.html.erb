<% provide(:title, "Настройки шрифта") %>

<div class="font-settings">
  <h1>Настройки шрифта</h1>
  
  <div class="current-settings">
    <p>Текущий размер шрифта: <strong><%= @current_font_size %>px</strong></p>
  </div>

  <div class="font-controls">
    <%= form_with url: font_path, method: :get, local: true do |form| %>
      <div class="form-group">
        <%= form.label :font_size, "Размер шрифта (px):" %>
        <%= form.number_field :font_size, 
              value: @current_font_size, 
              min: 8, 
              max: 72, 
              step: 1,
              class: "form-control" %>
      </div>
      
      <%= form.submit "Установить размер шрифта", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="preview">
    <h3>Предпросмотр:</h3>
    <div class="preview-content" style="font-size: <%= @current_font_size %>px;">
      <h4>Заголовок примера</h4>
      <p>Это пример текста с текущим размером шрифта. Здесь вы можете увидеть, как будет выглядеть текст на сайте.</p>
      <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
    </div>
  </div>

  <div class="quick-sizes">
    <h3>Быстрые настройки:</h3>
    <div class="btn-group">
      <%= link_to "Маленький (12px)", font_path(font_size: 12), class: "btn btn-outline-secondary" %>
      <%= link_to "Средний (16px)", font_path(font_size: 16), class: "btn btn-outline-secondary" %>
      <%= link_to "Большой (20px)", font_path(font_size: 20), class: "btn btn-outline-secondary" %>
      <%= link_to "Очень большой (24px)", font_path(font_size: 24), class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="navigation">
    <%= link_to "← На главную", root_path, class: "btn btn-link" %>
  </div>
</div>