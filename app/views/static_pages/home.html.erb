<% provide(:title, 'Home') %>
<div class="center jumbotron">
  <h1>Добро пожаловать!</h1>
  
  <h2>
    Это главная страница нашего приложения
  </h2>

  <% if logged_in? %>
    <div class="alert alert-success">
      <h3>Вы вошли как: <%= current_user.name %></h3>
      <p>Email: <%= current_user.email %></p>
      <% if current_user.last_login_at %>
        <p>Последний вход: <%= l current_user.last_login_at, format: :long %></p>
      <% end %>
    </div>
  <% else %>
    <%= link_to "Зарегистрироваться сейчас!", signup_path, class: "btn btn-lg btn-primary" %>
  <% end %>
</div>